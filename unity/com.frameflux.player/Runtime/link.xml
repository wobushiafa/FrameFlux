<linker>
  <!-- DnsClient TraceSource loads .NET configuration hosts through reflection. -->
  <assembly fullname="DnsClient" preserve="all" />
  <assembly fullname="System.Configuration" preserve="all" ignoreIfMissing="1" />
  <assembly fullname="System" ignoreIfMissing="1">
    <type fullname="System.Diagnostics.*" preserve="all" />
    <type fullname="System.Net.Configuration.*" preserve="all" />
  </assembly>
  <!-- Reverse P/Invoke delegate types, serializers, and SIPSorcery codecs must survive IL2CPP stripping. -->
  <assembly fullname="FrameFlux.Abstractions" preserve="all" />
  <assembly fullname="FrameFlux.Presentation" preserve="all" />
  <assembly fullname="FrameFlux.FFmpeg" preserve="all" />
  <assembly fullname="FrameFlux.WebRtc" preserve="all" />
  <assembly fullname="FrameFlux.Unity" preserve="all" />
  <assembly fullname="SIPSorcery" preserve="all" />
  <assembly fullname="SIPSorceryMedia.Abstractions" preserve="all" />
  <assembly fullname="BouncyCastle.Cryptography" preserve="all" />
  <assembly fullname="Microsoft.Bcl.AsyncInterfaces" preserve="all" />
  <assembly fullname="Tmds.LibC" preserve="all" />
</linker>
