<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>FrameFlux.FFmpeg.NativeAssets.Linux</PackageId>
    <Description>Linux native FFmpeg runtime assets for FrameFlux.</Description>
    <PackageTags>media;ffmpeg;native;linux;linux-x64;linux-arm64</PackageTags>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>FFMPEG-LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\native\licenses\FFMPEG-LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\native\licenses\FFMPEG-SOURCE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\native\build\linux\*" Pack="true" PackagePath="source-build\linux" />
    <None Include="..\..\native\build\linux-arm64\*" Pack="true" PackagePath="source-build\linux-arm64" />
    <None Include="..\..\native\artifacts\runtimes\linux-x64\native\*"
          Pack="true"
          PackagePath="runtimes\linux-x64\native" />
    <None Include="..\..\native\artifacts\runtimes\linux-arm64\native\*"
          Pack="true"
          PackagePath="runtimes\linux-arm64\native" />
  </ItemGroup>
  <Import Project="..\..\native\build\NativePackageSources.targets" />
</Project>
