<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>FrameFlux.FFmpeg.NativeAssets.Linux</PackageId>
    <Description>Linux native FFmpeg runtime assets for FrameFlux.</Description>
    <PackageTags>media;ffmpeg;native;linux;linux-x64</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\native\artifacts\runtimes\linux-x64\native\*"
          Pack="true"
          PackagePath="runtimes\linux-x64\native" />
  </ItemGroup>
</Project>
