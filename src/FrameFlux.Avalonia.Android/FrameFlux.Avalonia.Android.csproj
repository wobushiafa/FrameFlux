<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Avalonia.Android</PackageId>
    <Description>Android SurfaceTexture and OpenGL ES video presentation backend for FrameFlux Avalonia controls.</Description>
    <PackageTags>media;video;rendering;avalonia;android;opengl;mediacodec</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Avalonia\FrameFlux.Avalonia.csproj" />
    <ProjectReference Include="..\FrameFlux.FFmpeg.Android\FrameFlux.FFmpeg.Android.csproj" />
    <ProjectReference Include="..\FrameFlux.Presentation\FrameFlux.Presentation.csproj" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
