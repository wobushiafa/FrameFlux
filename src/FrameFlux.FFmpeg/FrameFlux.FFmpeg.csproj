<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0-android</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.FFmpeg</PackageId>
    <Description>Cross-platform FFmpeg media engine with RTSP playback for FrameFlux.</Description>
    <PackageTags>media;video;playback;rtsp;ffmpeg;streaming;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="FrameFlux.FFmpeg.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(FrameFluxNativeRuntimeIdentifier)' != ''">
    <Content Include="..\..\native\artifacts\runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\*"
             Link="runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

</Project>
