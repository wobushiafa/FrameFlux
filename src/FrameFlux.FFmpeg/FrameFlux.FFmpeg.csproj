<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;netstandard2.1;net10.0-android</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.FFmpeg</PackageId>
    <Description>Cross-platform FFmpeg media engine for network and local media playback.</Description>
    <PackageTags>media;video;playback;rtsp;ffmpeg;streaming;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio" Condition="'$(TargetFramework)' == 'net8.0'" />
    <InternalsVisibleTo Include="FrameFlux.FFmpeg.Tests" />
    <InternalsVisibleTo Include="FrameFlux.FFmpeg.Android" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Android" />
  </ItemGroup>

  <ItemGroup Condition="'$(FrameFluxNativeRuntimeIdentifier)' != ''">
    <Content Include="..\..\native\artifacts\runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\*"
             Link="runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FrameFlux.Compatibility\*.cs" Link="Compatibility\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
