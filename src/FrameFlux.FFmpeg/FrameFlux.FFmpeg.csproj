<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0-android</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.FFmpeg</PackageId>
    <Description>Cross-platform FFmpeg media engine with RTSP playback for FrameFlux.</Description>
    <PackageTags>media;video;playback;rtsp;ffmpeg;streaming;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="FrameFlux.FFmpeg.Tests" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia" />
    <InternalsVisibleTo Include="FrameFlux.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\artifacts\runtimes\**\native\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FrameFluxNativeRuntimeIdentifier)' != ''">
    <Content Include="..\..\native\artifacts\runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\*"
             Link="runtimes\$(FrameFluxNativeRuntimeIdentifier)\native\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-arm\native\*.so"
                          Link="lib\armeabi-v7a\%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-arm64\native\*.so"
                          Link="lib\arm64-v8a\%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-x86\native\*.so"
                          Link="lib\x86\%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-x64\native\*.so"
                          Link="lib\x86_64\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
