<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Avalonia.Windows</PackageId>
    <Description>Windows D3D11 video presentation backend for FrameFlux Avalonia controls.</Description>
    <PackageTags>media;video;rendering;avalonia;windows;d3d11</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Avalonia\FrameFlux.Avalonia.csproj" />
    <ProjectReference Include="..\FrameFlux.Presentation\FrameFlux.Presentation.csproj" />
    <ProjectReference Include="..\FrameFlux.Rendering.Windows\FrameFlux.Rendering.Windows.csproj" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FrameFlux.Avalonia\Rendering\WindowsD3D11CompositionMediaOutput.cs"
             Link="Rendering\WindowsD3D11CompositionMediaOutput.cs" />
    <Compile Include="..\FrameFlux.Avalonia\Rendering\WindowsD3D11MediaOutput.cs"
             Link="Rendering\WindowsD3D11MediaOutput.cs" />
  </ItemGroup>
</Project>
