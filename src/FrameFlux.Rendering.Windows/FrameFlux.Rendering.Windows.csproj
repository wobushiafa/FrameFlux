<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Rendering.Windows</PackageId>
    <Description>Shared Windows D3D11 video presentation for FrameFlux UI controls.</Description>
    <PackageTags>media;video;rendering;d3d11;windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <PackageReference Include="Vortice.Direct3D11" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Windows" />
    <InternalsVisibleTo Include="FrameFlux.Wpf" />
  </ItemGroup>
</Project>
