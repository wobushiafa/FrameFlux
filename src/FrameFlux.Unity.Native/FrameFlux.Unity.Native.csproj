<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FrameFluxUnity</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <NativeLib>Shared</NativeLib>
    <PublishAot Condition="'$(FrameFluxUnityPublishAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FrameFlux.FFmpeg/FrameFlux.FFmpeg.csproj" />
    <InternalsVisibleTo Include="FrameFlux.Unity.Tests" />
  </ItemGroup>
</Project>
