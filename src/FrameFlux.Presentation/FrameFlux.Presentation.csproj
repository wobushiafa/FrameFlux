<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;netstandard2.1;net10.0-android</TargetFrameworks>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Presentation</PackageId>
    <Description>Shared playback lifecycle orchestration for FrameFlux presentation controls.</Description>
    <PackageTags>media;video;playback;presentation;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Android" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Linux" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Windows" />
    <InternalsVisibleTo Include="FrameFlux.Wpf" />
    <InternalsVisibleTo Include="FrameFlux.FFmpeg.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\FrameFlux.Compatibility\*.cs" Link="Compatibility\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FrameFlux.Unity" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>
</Project>
