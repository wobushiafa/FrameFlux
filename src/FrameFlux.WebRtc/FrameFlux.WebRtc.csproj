<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;netstandard2.1;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24</SupportedOSPlatformVersion>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.WebRtc</PackageId>
    <Description>WebRTC real-time media engine for FrameFlux using SIPSorcery.</Description>
    <PackageTags>media;video;playback;webrtc;whep;whip;sipsorcery;streaming;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <ProjectReference Include="..\FrameFlux.Presentation\FrameFlux.Presentation.csproj" />
    <ProjectReference Include="..\FrameFlux.FFmpeg.Android\FrameFlux.FFmpeg.Android.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="NAudio" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="SIPSorcery" />
    <InternalsVisibleTo Include="FrameFlux.WebRtc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\FrameFlux.Compatibility\*.cs" Link="Compatibility\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NAudio.WinMM" />
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
