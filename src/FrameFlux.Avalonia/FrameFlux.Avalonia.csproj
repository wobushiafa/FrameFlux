<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0-android</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Avalonia</PackageId>
    <Description>Avalonia media playback controls for FrameFlux, including RTSP rendering and snapshots.</Description>
    <PackageTags>media;video;playback;rtsp;streaming;avalonia;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Abstractions\FrameFlux.Abstractions.csproj" />
    <ProjectReference Include="..\FrameFlux.Presentation\FrameFlux.Presentation.csproj" />
    <PackageReference Include="Avalonia" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Android" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Linux" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Windows" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Rendering\WindowsD3D11CompositionMediaOutput.cs" />
    <Compile Remove="Rendering\WindowsD3D11MediaOutput.cs" />
  </ItemGroup>

  <!-- Keep the generated AAR in sync when Android bindings change but no Android assets remain. -->
  <Target Name="TrackFrameFluxAvaloniaProjectForAarGeneration"
          BeforeTargets="_CreateAarCache"
          Condition="'$(TargetPlatformIdentifier)' == 'Android'">
    <ItemGroup>
      <_CreateAarInputs Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
  </Target>

</Project>
