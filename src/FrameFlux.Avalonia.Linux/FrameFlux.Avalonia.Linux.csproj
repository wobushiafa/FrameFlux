<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>FrameFlux.Avalonia.Linux</PackageId>
    <Description>Linux OpenGL video presentation backend for FrameFlux Avalonia controls.</Description>
    <PackageTags>media;video;rendering;avalonia;linux;opengl;vaapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\FrameFlux.Avalonia\FrameFlux.Avalonia.csproj" />
    <ProjectReference Include="..\FrameFlux.Presentation\FrameFlux.Presentation.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.X11" />
    <InternalsVisibleTo Include="FrameFlux.Avalonia.Linux.Tests" />
  </ItemGroup>
</Project>
