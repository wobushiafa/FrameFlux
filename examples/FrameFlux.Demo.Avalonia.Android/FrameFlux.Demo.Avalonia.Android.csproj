<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.frameflux.demo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <IsPackable>false</IsPackable>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <FrameFluxValidateAndroidPageAlignment>true</FrameFluxValidateAndroidPageAlignment>
    <WarningsAsErrors Condition="'$(FrameFluxAllowUnsupportedAndroidPageAlignment)' != 'true'">$(WarningsAsErrors);XA0141</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FrameFlux.Demo.Avalonia\FrameFlux.Demo.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\FrameFlux.Avalonia.Android\FrameFlux.Avalonia.Android.csproj" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-arm64\native\libavcodec.so;
                                   ..\..\native\artifacts\runtimes\android-arm64\native\libavfilter.so;
                                   ..\..\native\artifacts\runtimes\android-arm64\native\libavformat.so;
                                   ..\..\native\artifacts\runtimes\android-arm64\native\libavutil.so;
                                   ..\..\native\artifacts\runtimes\android-arm64\native\libswresample.so;
                                   ..\..\native\artifacts\runtimes\android-arm64\native\libswscale.so"
                          Link="lib\arm64-v8a\%(Filename)%(Extension)"
                          FrameFluxValidatePageAlignment="true" />
    <AndroidNativeLibrary Include="..\..\native\artifacts\runtimes\android-x64\native\libavcodec.so;
                                   ..\..\native\artifacts\runtimes\android-x64\native\libavfilter.so;
                                   ..\..\native\artifacts\runtimes\android-x64\native\libavformat.so;
                                   ..\..\native\artifacts\runtimes\android-x64\native\libavutil.so;
                                   ..\..\native\artifacts\runtimes\android-x64\native\libswresample.so;
                                   ..\..\native\artifacts\runtimes\android-x64\native\libswscale.so"
                          Link="lib\x86_64\%(Filename)%(Extension)"
                          FrameFluxValidatePageAlignment="true" />
  </ItemGroup>
</Project>
