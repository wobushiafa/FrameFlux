<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:frameFlux="using:FrameFlux.Avalonia"
             x:Class="FrameFlux.Demo.Avalonia.Views.MainView"
             Background="#111315">
  <Grid Margin="16"
        RowDefinitions="Auto,Auto,*,Auto,Auto,Auto"
        RowSpacing="12">
    <Grid RowDefinitions="Auto,Auto"
          ColumnDefinitions="*,Auto"
          RowSpacing="8"
          ColumnSpacing="8">
      <TextBox x:Name="SourceTextBox"
               MinHeight="48"
               PlaceholderText="RTSP URL or local file path"
               Text="rtsp://username:password@camera-host:554/stream"
               AutomationProperties.Name="Media source" />
      <Button x:Name="OpenFileButton"
              Grid.Column="1"
              MinHeight="48"
              Content="Open file"
              Click="OpenFileButton_OnClick"
              AutomationProperties.Name="Open local media file" />
      <StackPanel Grid.Row="1"
                  Grid.ColumnSpan="2"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button x:Name="StartButton"
                MinHeight="48"
                Classes="primary"
                Content="Play"
                Click="StartButton_OnClick"
                AutomationProperties.Name="Start playback" />
        <Button x:Name="StopButton"
                MinHeight="48"
                Content="Stop"
                Click="StopButton_OnClick"
                AutomationProperties.Name="Stop playback" />
      </StackPanel>
    </Grid>

    <WrapPanel Grid.Row="1"
               Orientation="Horizontal">
      <StackPanel Margin="0,0,16,0"
                  Orientation="Horizontal"
                  Spacing="8">
        <TextBlock VerticalAlignment="Center"
                   Text="Decode" />
        <ComboBox x:Name="HardwareModeComboBox"
                  Width="150"
                  SelectionChanged="PlaybackMode_OnSelectionChanged"
                  AutomationProperties.Name="Decode mode" />
      </StackPanel>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <TextBlock VerticalAlignment="Center"
                   Text="Render" />
        <ComboBox x:Name="RenderModeComboBox"
                  Width="150"
                  SelectionChanged="PlaybackMode_OnSelectionChanged"
                  AutomationProperties.Name="Render mode" />
      </StackPanel>
    </WrapPanel>

    <Border Grid.Row="2"
            Background="#050607"
            BorderBrush="#34383D"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True"
            MinHeight="120">
      <frameFlux:MediaView x:Name="Player"
                    AutoPlay="False"
                           PlaybackError="Player_OnPlaybackError"
                           PlaybackStateChanged="Player_OnPlaybackStateChanged"
                           Stretch="Uniform">
        <frameFlux:MediaView.Overlay>
          <Border x:Name="VideoOverlay"
                  Margin="12"
                  Padding="8,4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="#B30B0D0F"
                  CornerRadius="3"
                  IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <Border x:Name="SourceKindIndicator"
                      Width="7"
                      Height="7"
                      VerticalAlignment="Center"
                      Background="#EF4444"
                      CornerRadius="4" />
              <TextBlock x:Name="SourceKindTextBlock"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="White"
                         Text="LIVE" />
            </StackPanel>
          </Border>
        </frameFlux:MediaView.Overlay>
      </frameFlux:MediaView>
    </Border>

    <Grid Grid.Row="3"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,*,Auto"
          RowSpacing="8"
          ColumnSpacing="8">
      <TextBlock x:Name="PositionTextBlock" VerticalAlignment="Center"
                 FontFamily="Consolas" Text="00:00" />
      <Slider x:Name="PositionSlider" Grid.Column="1"
              Minimum="0" Maximum="1"
              PointerPressed="PositionSlider_OnPointerPressed"
              PointerReleased="PositionSlider_OnPointerReleased"
              AutomationProperties.Name="Playback position" />
      <TextBlock x:Name="DurationTextBlock" Grid.Column="2"
                 VerticalAlignment="Center" FontFamily="Consolas" Text="00:00" />
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                  Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="Speed" />
        <ComboBox x:Name="PlaybackRateComboBox"
                  MinWidth="96" MinHeight="48"
                  SelectionChanged="PlaybackRateComboBox_OnSelectionChanged"
                  AutomationProperties.Name="Playback speed" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="4"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center"
                 Text="Volume" />
      <Slider Grid.Column="1"
              MinWidth="120"
              Minimum="0"
              Maximum="1"
              Value="{Binding Volume, ElementName=Player, Mode=TwoWay}"
              AutomationProperties.Name="Playback volume" />
      <CheckBox Grid.Column="2"
                MinHeight="44"
                VerticalContentAlignment="Center"
                Content="Mute"
                IsChecked="{Binding IsMuted, ElementName=Player, Mode=TwoWay}"
                AutomationProperties.Name="Mute audio" />
    </Grid>

    <Grid Grid.Row="5"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="10">
      <Border x:Name="StateIndicator"
              Width="8"
              Height="8"
              VerticalAlignment="Center"
              Background="#6B7280"
              CornerRadius="4" />
      <TextBlock x:Name="StatusTextBlock"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Foreground="#D1D5DB"
                 Text="Ready" />
    </Grid>
  </Grid>
</UserControl>
